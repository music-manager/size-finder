# 센치픽 환경변수 예시 (값은 비워 둔다. 실제 값은 Netlify 환경변수에만 둔다.)
#
# 이 저장소에는 Coupang Partners Access Key / Secret Key 를 절대 두지 않는다.
# 자세한 내용: docs/coupang-api-policy.md

# Coordinator 모드: mock | live. live 는 ALLOW_COUPANG_LIVE=true 와 함께 줄 때만 열린다.
COUPANG_COORDINATOR_MODE=mock
ALLOW_COUPANG_LIVE=false

# 공용 Coordinator 엔드포인트 (https, .../functions/v1/coupang-coordinator)
COUPANG_COORDINATOR_URL=

# status / enqueue / cache_lookup 용 Coordinator 토큰 (서버 전용)
COUPANG_COORDINATOR_TOKEN=

# 중앙 coupang-worker-once(action=process_one) 호출 전용 토큰 (서버 전용).
# 중앙 client 중 allowed_actions 에 process_one, allowed_projects 에 size-finder 가 있는
# worker 전용 client 의 토큰이어야 한다. COUPANG_COORDINATOR_TOKEN 과 같은 값이면 부르지 않는다.
# 브라우저로 새지 않도록 이름 앞에 공개 접두어를 절대 붙이지 않는다.
COUPANG_WORKER_TOKEN=
